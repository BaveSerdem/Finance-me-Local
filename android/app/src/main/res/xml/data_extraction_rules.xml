<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and transfer rules. Every storage domain is excluded
  from both cloud backup and device-to-device transfer, so nothing in this
  app's sandbox (Hive box files under app_flutter/, secure-storage values and
  notification-plugin state under shared_prefs/) ever leaves the device
  through the system. Paired with android:allowBackup="false" in the
  manifest for Android 11 and below.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
